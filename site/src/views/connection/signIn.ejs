<link rel="stylesheet" href="/style/home/header.css">
<link rel="stylesheet" href="/style/globalStyle.css">
<link rel="stylesheet" href="/style/connection/styleLogin.css">
<script src="/javaScript/loginDisplay.js" defer></script>
<script src="/javaScript/menuBurger.js" defer></script>
<script src="/javaScript/style.js" defer></script>

<%- include('../partials/_head') %>
<%- include('../partials/_header') %>
<%- include('../partials/_alert')  %>

<main class="mainFrontOffice">
    <section class="login">
        <form class="form" action="/auth" method="post">
            <img src="/pictures/globalIcons/login.png" alt="Logo d'utilisateur">
            <label>
                <input type="email" id="email" placeholder="Email" name="email" value="">
            </label>
            <label class="labelRelative">
                <input  type="password" class="password" id="password" placeholder="Mot de passe" name="password">
                <img class="imgSrc" src="/pictures/globalIcons/closeEye.png" alt="Afficher le mot de passe">
            </label>
            <div class="remember">
                <div class="checkbox" id="rememberMe">
                    <label><input type="checkbox"></label>
                    <p>Se souvenir de moi</p>
                </div>
                <a href="">Mot de passe oublié</a>
            </div>
            <div class="buttonLogin">
                <button type="submit" class="btnSecondary btnHover widthBtnContact">CONNEXION</button>
                <a href="/signUp">Créer un compte</a>
            </div>                    
        </form>
    </section>
</main>    
</body>
</html>
