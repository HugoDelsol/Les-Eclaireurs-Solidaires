<% 
    let alertSelected = null;
    let alertClass = null;

    errorAlertMsg.length ? alertSelected = errorAlertMsg : alertSelected = successAlertMsg;
    errorAlertMsg.length ? alertClass = "errorAlertMsg" : alertClass = "successAlertMsg";

    if (alertSelected.length === 0){
        alertClass = null;
    }

%>

<div class="<%= alertClass %> alert" >
    <%= alertSelected %>
</div>

<div class="alertFrontOfficeSuccess alert"></div>
<div class="alertFrontOfficeError alert"></div>