<style>

    .successAlertMsg,
    .errorAlertMsg {
        position: fixed;
        border-radius: 10px;
        z-index: 500;
        padding: 20px;
        max-width: 60vw;
        bottom: 20px;
        left: -100vw;
        text-align: center; 
        transition: transform 0.6s; 
        color: white;  
        box-shadow: 0px 0px 6px rgba(0, 0, 0, 0.493);            
    }

    .successAlertMsg {        
        background-color: #27ae5f;
    }

    .errorAlertMsg {
        background-color: #e74d3c;          
    }    

</style>

<% 
    let alertSelected = null;
    let alertClass = null;

    errorAlertMsg.length ? alertSelected = errorAlertMsg : alertSelected = successAlertMsg;
    errorAlertMsg.length ? alertClass = "errorAlertMsg" : alertClass = "successAlertMsg";

    if (!alertSelected.length) {
        alertClass = "";
    }
%>

<div class="<%= alertClass %> alert" >
    <%= alertSelected %>
</div>

<div class="alert"></div>

<script>

    const alertMsg = document.querySelector(".alert");
    const body = document.querySelector("body");

    if (window.innerWidth < 1080) {
        alertMsg.style.bottom = "100px"
    }

    if (alertMsg.textContent) {

        alertMsg.style.transform = "translateX(102vw)";

        setTimeout(() => {
            alertMsg.style.transform = "translateX(-100vw)";
        }, 5000); 
    }    
   
</script>