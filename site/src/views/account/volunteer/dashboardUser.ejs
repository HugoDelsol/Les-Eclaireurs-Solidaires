<link rel="stylesheet" href="/style/globalStyle.css">
<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/styleDashboardUser.css">
<link rel="stylesheet" href="/style/modal/unsubscribe.css">
<link rel="stylesheet" href="/style/modal/userOpinion.css">
<script src="/javaScript/carrouselDashboard.js" defer></script>
<script src="/javaScript/style.js" defer></script>
<script src="/javaScript/unsubscribe.js" defer></script>
<script src="/javaScript/addOpinion.js" defer></script>

<%- include('../../partials/_head') %>
<%- include('../../partials/_alert') %>
<%- include('../../partials/_mobileHeader') %>

<div class="modalContain"></div>
<div class="modalContainOpinion">
    <div>
        <form>
            <label for="userOpinion">Votre avis nous aide à progresser</label>
                <textarea name="userOpinion" id="userOpinion"></textarea>        
            <button type="submit" class="sendOpinion"><img src="pictures/globalIcons/envoyer(1).png" alt=""></button>
        </form>
    </div>    
</div>

<div class="containerDisplay">
<%- include('../../partials/_sideNavUser') %>
<main class="mainBackOffice">
    
        <div class="alertFront"></div>
        <div class="dashboardContainer">            

            <!-- ================= HEADER ================= -->
            <div class="headerDashboard">

                <div class="myStats background">
                    <div class="titleCard">
                        <h1>Vos statistiques</h1>
                        <div class="lineTitle"></div>
                    </div>

                    <div class="statAlign">
                        <p>Mission complétées</p>
                        <p><span><%= statsOnVolunteer.resultNbrMissionAccomplished.length === 0 ? "0" : statsOnVolunteer.resultNbrMissionAccomplished[0].nbr %></span></p>
                    </div>

                    <div class="statAlign">
                        <p>Heures de bénévolat</p>
                        <p><span><%= nbrTimeAccomplished %></span></p>
                    </div>

                    <div class="statAlign">
                        <p>Rang</p>
                        <p><span>Nouveau Feu 🔥</span></p>
                    </div>
                </div>

                <div class="nearMission background">
                    <div class="titleCard">
                            <h1>Sélections pour vous</h1>
                        <div class="lineTitle"></div>
                    </div>

                    <div class="flexCardsMission">
                        <% for (let m of missionByRegion) { %>
                            <% console.log(m) %>
                            <div class="cardMission" style="background-image: url('<%= m.mission_img %>');">
                                <div class="alignItemInCard" >
                                    <p class="strong"><%= m.mission_title %></p>
                                    <p>
                                        <span><%= m.mission_available_place %></span> places disponible
                                    </p>
                                    <a style="text-align: center;" class="btnSecondary btnHover" href="/missionDetails/<%= m.id_mission %>">Voir d'avantage</a>                           
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- RESPONSIVE REGION -->
                    <div class="flexCardsMissionResponsiv">
                        <div class="rowArrow ifNoDataRegion">
                            <img class="arrowResponsiv arrowLeft" src="pictures/globalIcons/arrow.png" alt="">

                            <div class="cardMission imgRegion " style="background-image: url('');">
                                <div class="alignItemInCard">
                                    <p class="strong mission-title"></p>
                                    <p>
                                        <span class="mission-available-place"> </span> places disponibles 
                                    </p>
                                    <a class="btnSecondary btnHover btnDetailMissionRegion" href="#">Voir d'avantage</a>
                                </div>
                            </div>

                            <img class="arrowResponsiv arrowRight" src="pictures/globalIcons/arrow.png" alt="">
                        </div>
                    </div>
                </div>
            </div>

            <!-- ================= MIDDLE ================= -->
            <div class="middleDashboard">
                <div class="titleCard">
                    <% if (!missionsUser.length) { %>
                        <h1>Vos missions à effectuer seront visibles ici</h1>
                    <% } else { %>
                        <h1>Votre engagement</h1>
                    <% } %>
                    <div class="lineTitle"></div>
                </div>

                <table>
                    <thead>
                        <tr class="colorBack">
                            <th>MISSION</th>
                            <th>DATE</th>
                            <th>LIEUX</th>
                            <th>DETAILS</th>
                            <th>SE DÉSINSCRIRE</th>
                        </tr>
                    </thead>
                    <tbody class="fixMax">
                        <% for (let i = 0; i < missionsUser.length; i++) { %>
                            <tr>
                                <td><p><%= missionsUser[i].mission_title %></p></td>
                                <td class="color"><%= missionsUser[i].mission_date %></td>
                                <td class="color"><%= missionsUser[i].city_name %></td>
                                <td><a href="/detailsOfNextMission/<%= missionsUser[i].id_mission %>">Voir davantage</a></td>
                                <td>Désinscription <input type="checkbox" data-id="<%= JSON.stringify({id: missionsUser[i].id_registration, title: missionsUser[i].mission_title}) %>" class="checkbox"></td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>

                <!-- RESPONSIVE REGISTER -->
                <div class="flexCardsMissionResponsiv">
                    <div class="rowArrow ifNoDataRegister">
                        <img class="arrowResponsiv arrowLeftRegistration" src="pictures/globalIcons/arrow.png" alt="">

                        <div class="cardMission imgRegister " style="background-image: url('');">
                            <div class="alignItemInCard">
                                <p class="strong title-mission-register">title</p>
                                <p class="place-mission-register">lieux</p>
                                <p class="date-mission-register">date</p>
                                <a class="btnSecondary btnHover btnDetailMissionRegistration" href="">Voir d'avantage</a>
                                <a class="btnPrimary btnHover btnUnsubscribe" data-id="">Se désinscrire</a>
                            </div>
                        </div>

                        <img class="arrowResponsiv arrowRightRegistration" src="pictures/globalIcons/arrow.png" alt="">
                    </div>
                </div>
            </div>

            <!-- ================= END ================= -->
            <div class="endDashboard">
                <div class="titleCard">
                    <% if (historyMissionUser.length == 0) { %>
                        <h1>Vos missions accomplies seront visibles ici</h1>
                    <% } else { %>
                        <h1>Missions accomplies</h1>
                    <% } %>
                    <div class="lineTitle"></div>
                </div>

                <table class="completed">
                    <thead>
                        <tr class="colorBack">
                            <th>MISSION</th>
                            <th>DATE</th>
                            <th>STATUT</th>
                            <th>AVIS</th>
                        </tr>
                    </thead>
                    <tbody class="fixMax">
                        <% for (let h of historyMissionUser) { %>
                            <tr>
                                <td><p><%= h.mission_title %></p></td>
                                <td class="color"><%= h.mission_date %></td>
                                <td class="color">Terminé</td>
                                <td><a class="addOpinion" href="/addOpinion">Laisser un avis</a></td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>

                <!-- RESPONSIVE ACCOMPLISHED -->
                <div class="flexCardsMissionResponsiv">
                    <div class="rowArrow ifNoDataAccomplished">
                        <img class="arrowResponsiv arrowLeftAccomplished" src="pictures/globalIcons/arrow.png" alt="">

                        <div class="cardMission imgAccomplished " style="background-image: url('');">
                            <div class="alignItemInCard">                                
                                <p class="strong title-mission-accomplished">title</p>
                                <p class="date-mission-accomplished">date</p>
                                <p class="place-mission-accomplished">statut</p>
                                <a href="/addOpinion" class="btnSecondary btnHover addOpinion">Laisser un avis</a>
                            </div>
                        </div>

                        <img class="arrowResponsiv arrowRightAccomplished" src="pictures/globalIcons/arrow.png" alt="">
                    </div>
                </div>
            </div>

        </div>
    
</main>
</div>




<%- include('../../partials/_mobileFooter') %>
