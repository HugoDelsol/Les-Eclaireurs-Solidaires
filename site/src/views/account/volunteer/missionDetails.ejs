<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/modal/subscribe.css">
<link rel="stylesheet" href="/style/globalStyle.css">
<link rel="stylesheet" href="/style/modal/subscribe.css">
<link rel="stylesheet" href="/style/account/missionDetails.css">

<script src="/javaScript/registerMission.js" defer></script>
<script src="/javaScript/style.js" defer></script>

<%- include('../../partials/_head') %>
<%- include('../../partials/_alert') %>
<%- include('../../partials/_mobileHeader') %>

<div class="modalContain"></div>

<div class="containerDisplay">
<%- include('../../partials/_sideNavUser') %>
    <main class="mainBackOffice">
        <div class="background backgroundCards">
            <div class="lineTitle">
                <h1>Détails de la mission</h1>
                <div class="line"></div>
            </div>
            <img src="<%= dataMission[0].mission_img %>" alt="">
            <div class="imagetest"></div>
            <div class="container">
                <div class="colLeft">
                    <h1 class="border"><%= dataMission[0].mission_title %></h1>
                    <p class="border"><%= dataMission[0].mission_description %></p>
                    <p class="border">Catégorie : <%= dataMission[0].mission_category_name %> </p>
                </div>
                <div class="colRight">
                    <div class="border">
                        <p>LE <%= dateFormat %></p>
                        <p>De <%= timeFormat.timeFormatStart %> à <%= timeFormat.timeFormatEnd %></p>
                    </div> 
                    <div class="border">
                        <p><%= dataMission[0].mission_place_name %></p>
                        <p><%= dataMission[0].city_postal_code %> <%= dataMission[0].city_name %> </p>
                    </div>
                    <div class="border">
                        <p><%= dataMission[0].mission_available_place %> places disponible </p>  
                    </div>                                       
                </div>    
            </div>
            <a href="/modalRegisterMission" class="btnSecondary btnHover btnRegistration" data-id="<%= JSON.stringify({id: dataMission[0].id_mission, title: dataMission[0].mission_title }) %>">Rejoindre</a>
        </div>
    </main>
</div>



<%- include('../../partials/_mobileFooter') %>
