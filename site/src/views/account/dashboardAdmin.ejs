<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/styleDashboardAdmin.css">
<%- include('../partials/_head') %>
    <%- include('../partials/_alert') %>

        <main>
            <div class="container" style='display: flex;'>
                <%- include('../partials/_sideNavAdmin') %>

                    <div class="dashboardContainer">

                        <div class="colHeader">
                            <div class="title">
                                <h1>Vue synthétique - Missions & Bénévoles</h1>
                                <p>Période : 30 prochains jours</p>
                            </div>
                            <div class="header">
                                <div class="headerCards background">
                                    <h2>Missions à venir</h2>
                                    <h3>8</h3>
                                    <p>Planifiées sur 30 jours</p>
                                </div>
                                <div class="headerCards background">
                                    <h2>Bénévoles engagés</h2>
                                    <h3><%= resultSum %></h3>
                                    <p>Sommes des inscrits</p>
                                </div>
                                <div class="headerCards background">
                                    <h2>Taux moyen de remplissage</h2>
                                    <h3><%= average + "%" %></h3>
                                    <p>Moyenne sur l'ensemble des missions</p>
                                </div>
                            </div>
                        </div>

                        <table class="background tablePadding">
                                <thead>
                                    <tr class="colorBack">
                                        <th>Mission</th>
                                        <th>Date</th>
                                        <th>Bénévoles engagées</th>
                                        <th>Besoins restants</th>
                                        <th>Taux de remplissage</th>
                                        <th>Statut</th>
                                        <th>Modifier</th>
                                    </tr>
                                </thead>
                                <tbody class="fixMax">
                                    <% for (let t of tabStats) { %>
                                        <tr>
                                            <td>
                                                <p>
                                                    <%= t.mission %>
                                                </p>
                                            </td>
                                            <td class="color">
                                                <%= t.date %>
                                            </td>
                                            <td>
                                               <%= t.nbVolunteers %>
                                            </td>
                                            <td>
                                               <%= t.spaceAvailable %>
                                            </td>
                                            <td class="color">
                                                <%= t.fillRate %>
                                            </td>
                                            <td> <a class="btnSecondary btnHover" href="/dataMission/<%= t.id %>">À promouvoir</a></td>
                                            <td>
                                                <a href="" class="btnPrimary btnHover">Mettre a jour</a>
                                            </td>
                                        </tr>
                                        <% } %>
                                </tbody>
                            </table>
                    </div>


            </div>
        </main>

        </body>

        </html>