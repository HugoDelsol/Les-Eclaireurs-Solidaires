<link rel="stylesheet" href="/style/globalStyle.css">
<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/styleDashboardAdmin.css">
<script src="/javaScript/style.js" defer></script>
<%- include('../../partials/_head') %>
    <%- include('../../partials/_alert') %>


    <div class="containerDisplay">
        <%- include('../../partials/_sideNavAdmin') %>

        <main class="mainBackOffice">

                    <div class="dashboardContainer">

                        <div class="colHeader">
                            <div class="title">
                                <h1>Vue synthétique - Missions & Bénévoles</h1>
                                <p>Période : 30 prochains jours</p>
                            </div>
                            <div class="header">
                                <div class="headerCards backgroundCards">
                                    <div class="designLine">
                                        <h2>Missions à venir</h2>
                                        <div class="line"></div> 
                                    </div> 
                                    <h3><%= totalMission.nbr_missions %></h3>  
                                    <p>Planifiées sur 30 jours</p>
                                </div>
                                <div class="headerCards backgroundCards">
                                    <div class="designLine">
                                        <h2>Bénévoles engagés</h2>
                                        <div class="line"></div> 
                                    </div> 
                                    <h3><%= resultSum %></h3>
                                    <p>Sommes des inscrits</p>
                                </div>
                                <div class="headerCards backgroundCards">
                                    <div class="designLine">
                                        <h2>Taux moyen de remplissage</h2>
                                        <div class="line"></div> 
                                    </div> 
                                    <h3><%= average + "%" %></h3>
                                    <p>Moyenne sur l'ensemble des missions</p>
                                </div>
                            </div>
                        </div>

                        <table class="backgroundCards tablePadding">
                                <thead>
                                    <tr class="colorBack">
                                        <th>Mission</th>
                                        <th>Date</th>
                                        <th>Bénévoles engagées</th>
                                        <th>Besoins restants</th>
                                        <th>Taux de remplissage</th>
                                        <th>Statut</th>
                                        <th>Détails</th>
                                    </tr>
                                </thead>
                                <tbody class="fixMax">
                                    <% for (let t of tabStats) { %>
                                        <tr>
                                            <td>
                                                <p>
                                                    <%= t.mission %>
                                                </p>
                                            </td>
                                            <td class="color">
                                                <%= t.date %>
                                            </td>
                                            <td>
                                               <%= t.nbVolunteers %>
                                            </td>
                                            <td>
                                               <%= t.spaceAvailable %>
                                            </td>
                                            <td class="color">
                                                <%= t.fillRate %>
                                            </td>
                                            <td> <a class="btnSecondary btnHover" href="/dataMission/<%= t.id %>">À promouvoir</a></td>
                                            <td>
                                                <a href="" class="btnPrimary btnHover">Informations</a>
                                            </td>
                                        </tr>
                                        <% } %>
                                </tbody>
                            </table>
                    </div>


                </main>
            </div>

        </body>

        </html>