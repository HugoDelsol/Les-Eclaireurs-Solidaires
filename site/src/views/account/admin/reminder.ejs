<link rel="stylesheet" href="/style/globalStyle.css">
<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/reminder.css">
<script src="/javaScript/style.js" defer></script>
<%- include('../../partials/_head') %>
<%- include('../../partials/_alert') %>


<main>
    <div class="container">        
        <%- include('../../partials/_sideNavAdmin') %>
        <section class="managementSection">
            <form class="recallManagement bloc" method="post" action="/admin/recallManagement" >
                <div class="justify">                    
                    <div class="lineTitle">                    
                        <h1>Gestion des rappels</h1>  
                        <div class="line"></div>
                    </div> 
                    <button type="submit" class="btnSecondary btnHover">Enregistrer</button> 
                </div>   
                <fieldset>
                    <legend>Paramètres d'envoi</legend>
                    <label for="imgActivated" class="rowReverse">
                        <input <%= dataView.recallIsCheckeds ? "checked" : "" %> type="checkbox" value="true" name="recallIsCheckeds" id="imgActivated">- Activer les rappels automatiques
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div> 
                    </label><br>

                    <label class="marginLeft">
                        - Délai d'anticipation :
                        <select name="selectedDelay">                            
                            <option 
                                value="J-1"
                                <%= dataView.selectedDelay === "J-1" ? "selected" : "" %>
                                > J-1
                            </option>
                            <option value="J-3"
                                <%= dataView.selectedDelay === "J-3" ? "selected" : "" %> 
                                > J-3
                            </option>                            
                            <option
                                value="J-7"
                                <%= dataView.selectedDelay === "J-7" ? "selected" : "" %> 
                                > J-7
                            </option>
                        </select>
                    </label><br>

                </fieldset>

                <fieldset>
                    <legend>Canaux prioritaires</legend>
                    <label for="imgEmail" class="rowReverse">
                        <input <%= dataView.emailMessage ? "checked" : "" %> type="checkbox" value="true" name="emailMessage" id="imgEmail">- Email (Détails complets)
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div> 
                    </label><br>
                    <label for="imgSms" class="rowReverse">
                        <input <%= dataView.smsMessage ? "checked" : "" %> type="checkbox" value="true" name="smsMessage" id="imgSms">- SMS (Urgent / Rappel jour J)
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div>                         
                    </label><br>
                    <label for="imgPush" class="rowReverse">
                        <input <%= dataView.pushMessage ? "checked" : "" %> type="checkbox" value="true" name="pushMessage" id="imgPush">- Notification Push (Alerte mobile)
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div>                         
                    </label><br>
                </fieldset>
                
                <fieldset>
                    <legend>Pilotage et Engagement</legend>
                    <label for="imgAlert" class="rowReverse">
                        <input <%= dataView.alert ? "checked" : "" %> type="checkbox" value="true" name="alert" id="imgAlert"> - Alerte de vigilance : Me prévenir si le taux d'annulation dépasse 50%
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div>
                    </label><br>
                    <label for="imgRestart" class="rowReverse">
                        <input <%= dataView.restart ? "checked" : "" %> type="checkbox" value="true" name="restart" id="imgRestart"> - Relance intelligente : Relancer uniquement ceux qui n'ont pas confirmé
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div>
                    </label><br>
                    <label for="imgThank" class="rowReverse">
                        <input <%= dataView.thank ? "checked" : "" %> type="checkbox" value="true" name="thank" id="imgThank">  - Clôture de mission : Envoyer un message de remerciement automatique
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div>
                    </label>
                </fieldset>
               

            </form>
            <form class="opportunitieManagement bloc">
                <div class="justify">                    
                    <div class="lineTitle">                    
                        <h1>Promotion des Opportunités</h1>  
                        <div class="line"></div>
                    </div>      
                    <button type="submit" class="btnSecondary btnHover">Enregistrer</button> 
                </div>
                <fieldset>
                    <legend>Planification</legend>
                    <label for="imgEmail" class="rowReverse">
                        <input <%= dataView.mail ? "checked" : "" %> type="checkbox" value="true" name="mail" id="imgEmail">- Activer la diffusion automatique
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div> 
                    </label><br>

                    <label  class="marginLeft">
                        - Fréquence d'envoi :
                        <select>
                            <option>Mensuelle</option>
                            <option>Hebdomadaire</option>
                        </select>
                    </label><br>
                    <label for=""  class="marginLeft">
                        - Jour d'envoi :
                        <select name="" id="">
                            <option value="">Lundi</option>
                            <option value="">Mercredi</option>
                            <option value="">Dimanche</option>
                        </select>
                    </label><br>

                </fieldset>

                <fieldset>
                    <legend>Canal</legend>
                    <label for="imgEmail" class="rowReverse">
                        <input <%= dataView.mail ? "checked" : "" %> type="checkbox" value="true" name="mail" id="imgEmail">- Email
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div> 
                    </label><br>
                    <label for="imgEmail" class="rowReverse">
                        <input <%= dataView.mail ? "checked" : "" %> type="checkbox" value="true" name="mail" id="imgEmail">- SMS
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div> 
                    </label><br>
                    <label for="imgEmail" class="rowReverse">
                        <input <%= dataView.mail ? "checked" : "" %> type="checkbox" value="true" name="mail" id="imgEmail">- Notification
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div> 
                    </label><br>
                </fieldset>
                
                <fieldset>
                    <legend>Ciblage des volontaires</legend>                    
                    <label for="imgEmail" class="rowReverse">
                        <input <%= dataView.mail ? "checked" : "" %> type="checkbox" value="true" name="mail" id="imgEmail"> - Par affinité : Selon les préférences et types de missions favoris
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div> 
                    </label><br>                  
                    <label for="imgEmail" class="rowReverse">
                        <input <%= dataView.mail ? "checked" : "" %> type="checkbox" value="true" name="mail" id="imgEmail"> - Par fidélité : Cibler les volontaires les plus actifs
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div> 
                    </label><br>             
                    <label for="imgEmail" class="rowReverse">
                        <input <%= dataView.mail ? "checked" : "" %> type="checkbox" value="true" name="mail" id="imgEmail"> - Campagne de réactivation : Cibler les profils inactifs (longue période sans mission) 
                        <div class="label"> <img src="/pictures/LogoV2/lanterne.png" alt="" srcset=""> </div> 
                    </label><br>
                </fieldset>

            </form>
        </section>
    </div>
</main>
