<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/reminder.css">
<%- include('../../partials/_head') %>
<%- include('../../partials/_alert') %>


<main>
    <div class="container">        
        <%- include('../../partials/_sideNavAdmin') %>
        <section class="managementSection">
            <form class="recallManagement bloc" method="post" action="/admin/recallManagement" >
                <div class="jutify">                    
                    <div class="lineTitle">                    
                        <h1>Gestion des rappels</h1>  
                        <div class="line"></div>
                    </div> 
                    <button type="submit" class="btnSecondary btnHover">Enregistrer les modifications</button> 
                </div>   
                <fieldset>
                    <legend>Paramètres d'envoi</legend>
                    <label>
                        <input <%= recallIsChecked ? "checked" : "" %> type="checkbox" value="true" name="recallIsCheckeds" id="recallIsChecked">- Activer les rappels automatiques
                    </label><br>

                    <label class="marginLeft">
                        - Délai d'anticipation :
                        <select name="selectedDelay">                            
                            <option value="J-7">J-7</option>
                            <option value="J-3">J-3</option>
                            <option value="J-1">J-1</option>
                        </select>
                    </label><br>

                </fieldset>

                <fieldset>
                    <legend>Canaux prioritaires</legend>
                    <label><input type="checkbox" value="true" name="mail" id="mail">- Email (Détails complets)</label><br>
                    <label><input type="checkbox" value="true" name="sms" id="sms">- SMS (Urgent / Rappel jour J)</label><br>
                    <label><input type="checkbox" value="true" name="push" id="push">- Notification Push (Alerte mobile)</label><br>
                </fieldset>

                <fieldset>
                    <legend>Pilotage et Engagement</legend>
                    <label><input type="checkbox"> - Alerte de vigilance : Me prévenir si le taux d'annulation dépasse 50%</label><br>
                    <label><input type="checkbox"> - Relance intelligente : Relancer uniquement ceux qui n'ont pas confirmé</label><br>
                    <label><input type="checkbox"> - Clôture de mission : Envoyer un message de remerciement automatique</label>
                </fieldset>
               

            </form>
            <form class="opportunitieManagement bloc">
                <div class="jutify">                    
                    <div class="lineTitle">                    
                        <h1>Promotion des Opportunités</h1>  
                        <div class="line"></div>
                    </div>      
                    <button type="submit" class="btnSecondary btnHover">Enregistrer les modifications</button> 
                </div>
                <fieldset>
                    <legend>Planification</legend>
                    <label>
                        <input type="checkbox">- Activer la diffusion automatique
                    </label><br>

                    <label  class="marginLeft">
                        - Fréquence d'envoi :
                        <select>
                            <option>Mensuelle</option>
                            <option>Hebdomadaire</option>
                        </select>
                    </label><br>
                    <label for=""  class="marginLeft">
                        - Jour d'envoi :
                        <select name="" id="">
                            <option value="">Lundi</option>
                            <option value="">Mercredi</option>
                            <option value="">Dimanche</option>
                        </select>
                    </label><br>

                </fieldset>

                <fieldset>
                    <legend>Canal</legend>
                    <label><input type="checkbox">- Email</label><br>
                    <label><input type="checkbox">- SMS</label><br>
                    <label><input type="checkbox">- Notification</label><br>
                </fieldset>
                
                <fieldset>
                    <legend>Ciblage des volontaires</legend>                    
                    <label><input type="checkbox" name="preferences">- Par affinité : Selon les préférences et types de missions favoris</label><br>                  
                    <label><input type="checkbox" name="tous_volontaires">- Par fidélité : Cibler les volontaires les plus actifs</label><br>                   
                    <label><input type="checkbox" name="moins_engages">- Campagne de réactivation : Cibler les profils inactifs (longue période sans mission)</label> 
                </fieldset>

            </form>
        </section>
    </div>
</main>
