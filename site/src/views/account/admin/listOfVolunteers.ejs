<link rel="stylesheet" href="/style/globalStyle.css">
<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/styleListOfVolunteers.css">
<script src="/javaScript/style.js" defer></script>
<script src="/javaScript/minWidthRequired.js" defer></script>
<%- include('../../partials/_head') %>
    <%- include('../../partials/_alert') %>

    <div class="containerDisplay">
        <%- include('../../partials/_sideNavAdmin') %>
        <main class="mainBackOffice">
                    <section class="blocListVolunteers">
                        <div class="titleAndCategorySearch">
                            <div class="">
                                <h1>Liste des bénévoles</h1>
                                <div class="line"></div>
                            </div>
                            <form action="/admin/findVolunteer" method="post">
                                <div class="divBtnSelected">
                                    <a class="btnPrimary btnHover" href="activeVolunteer">Bénévoles actifs</a>
                                    <p class="separator">|</p>
                                    <a class="btnPrimary btnHover" href="listOfVolunteers">Tous les bénévoles</a>
                                </div>

                                <label for="">
                                    <input type="text" name="findVolunteer" placeholder="Rechercher par email">
                                </label>
                                <select name="regionSelected" id="regionSelected">
                                    <option value="">Régions</option>
                                    <% for (let r of regions) { %>
                                        <option value="<% r.id_region %>" <% r.id_region == searchFilters.regionSelected
                                            ? "selected" : "" %> >
                                            <%= r.region_name %>
                                        </option>
                                        <% } %>
                                </select>
                                <select name="categorySelected" id="categorySelected">
                                    <option value="">Catégories</option>
                                    <% for (let c of categoriesMission) { %>
                                        <option value="<% c.id_mission_category %>" <%
                                            c.id_mission_category == searchFilters.categorySelected ? "selected" : "" %> >
                                            <%= c.mission_category_name %>
                                        </option>
                                        <% } %>
                                </select>
                                <button class="btnSecondary btnHover" type="submit" >Rechercher</button>


                            </form>
                        </div>
                        <table class="desktop">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Prénom</th>
                                    <th>Contact</th>
                                    <th>Engagement <a href="">- test</a></th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody class="fixMax">
                                <% const list = listUsers || findVolunteerList %>
                                <% for (let l of list) {%>
                                    <tr>
                                        <td>
                                            <p>
                                                <%= l.user_last_name %>
                                            </p>
                                        </td>
                                        <td class="color">
                                            <p>
                                                <%= l.user_first_name%>
                                            </p>
                                        </td>
                                        <td>
                                            <p class="btnSecondary btnHover">
                                                <a href="/admin/sendMessageTo/<%= l.id_user %>"><%= l.identifier_mail %></a>
                                            </p>
                                        </td>
                                        <td>
                                            <p>
                                                <%= l.nbr_registration %>
                                            </p>
                                        </td>
                                        <td>
                                            <a href="" class="btnPrimary btnHover">Suspendre</a>
                                        </td>
                                    </tr>
                                    <% } %>
                            </tbody>
                        </table>

                    </section>
                </main>
            </div>
    </body>
</html>