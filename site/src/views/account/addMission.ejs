<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/styleAddMission.css">
<script src="/javaScript/inputCityAuto.js" defer></script>

<%- include("../partials/_head") %>

    <main>
        <div class="container" style='display: flex;'>
            <%- include('../partials/_sideNavAdmin') %>
                <section class="blocAddMission">
                    <h1>Publier une mission :</h1>
                    <div class="line"></div>
                    <form lang="fr" action="/admin/addMission" method="post">
                        <div class="titleCategory">
                            <label id="title">Titre de la mission :<input type="text" name="title" id="title"
                                    value="" /></label>
                            <select name="category" id="category">
                                <% for (let category of categoriesMission) { %>
                                    <option value="<%= category.categoryId %>">
                                        <%= category.categoryName %>
                                    </option>
                                    <% } %>
                            </select>
                        </div>
                        <label id="description">Description :<textarea type="text" name="description"
                                value=""></textarea></label>
                        <div class="timeDate">
                            <label id="date">Date :<input type="date" name="date" value="" /></label>
                            <label id="startTime">Heure de début :<input type="time" name="startTime"
                                    value="" /></label>
                            <label id="endTime">Heure de fin :<input type="time" name="endTime" value="" /></label>
                        </div>
                        <div class="cityPlace">
                            <label id="city">Ville :<input class="city" type="text" name="city" value="" /> <input
                                    type="hidden" name="cityId" class="cityId">
                                <ul class="displayListCity"></ul>
                            </label>
                            <label id="placeName">Lieu :<input type="text" name="placeName" value="" /></label>
                        </div>
                        <div class="places">
                            <label id="spaceAvailable" class="column">Nombre de place :
                                <input type="number" name="spaceAvailable" value="" />
                            </label>
                            <label id="uploadImg" for="fileUpload" class="customFileUpload">Choisir une image :
                                <input id="fileUpload" type="file" class="paddingTypeFile" name="uploadImg" value="" />
                            </label>
                        </div>
                        <h3 style="color: red;">
                            <%= alertMsg %>
                        </h3>
                        <button type="submit" class="btnPrimary btnHover">PUBLIER</button>
                    </form>
                </section>
        </div>
    </main>

    </body>

    </html>