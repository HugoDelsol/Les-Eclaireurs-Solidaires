<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/styleListMission.css">
<link rel="stylesheet" href="/style/modal/subscribe.css">
<script src="/javaScript/registerMission.js" defer></script>

<%- include('../partials/_head') %>
    <%- include('../partials/_alert') %>

        <main>
            <div class="modalContain"></div>

            <div class="container">
                <%- include('../partials/_sideNavUser') %>
                    <%- include('../partials/_mobileHeader') %>

                        <section class="blocListMission">
                            <div class="titleAndCategorySearch">
                                <div class="rowResponsiv">
                                    <div class="line responsiv"></div>
                                    <h1>Mission disponible</h1>
                                    <div class="line"></div>
                                </div>

                                <form action="/searchByCategories" method="post">
                                    <div class="rowResponsiv rowDesktop">
                                        <div>
                                            <p class="responsivMob">Lieu</p>
                                            <select name="regionSelected" id="regionSelected">
                                                <option value="">Régions</option>
                                                <% for (let region of regions) { %>
                                                    <option value="<%= region.id_region %>"
                                                        <%= region.id_region==regionSelected ? "selected" : "" %>>
                                                        <%= region.region_name %>
                                                    </option>
                                                    <% } %>
                                            </select>
                                            <p class="responsivMob">Categorie</p>
                                            <select name="categorySelected" id="categorySelected">
                                                <option value="">Catégories</option>
                                                <% for (let category of categoriesMission) { %>
                                                    <option value="<%= category.id_mission_category %>"
                                                        <%= category.id_mission_category==categorySelected ? "selected"
                                                        : "" %>>
                                                        <%= category.mission_category_name %>
                                                    </option>
                                                    <% } %>
                                            </select>
                                        </div>

                                        <div class="filterDate">
                                            <div>
                                                <p>Du :</p>
                                                <input type="date" id="tripStart" name="tripStart">
                                            </div>
                                            <div>
                                                <p>Au :</p>
                                                <input type="date" id="tripEnd" name="tripEnd">
                                            </div>
                                        </div>
                                        <button class="btnSecondary btnHover" type="submit">Rechercher</button>
                                        <a href="/missionUserShow"><img class="btnReset" src="/pictures/recycler.png"
                                                alt=""></a>
                                    </div>
                                </form>
                            </div>

                            <table class="desktop">
                                <thead>
                                    <tr>
                                        <th>MISSION</th>
                                        <th>DATE</th>
                                        <th>CATEGORIES</th>
                                        <th>LIEUX</th>
                                        <th>DETAILS</th>
                                        <th>S'INSCRIRE</th>
                                    </tr>
                                </thead>
                                <tbody class="fixMax">
                                    <% if (missionSelected) { %>
                                        <% for (let i=0; i < missionSelected.length; i++) { %>
                                            <tr>
                                                <td>
                                                    <p>
                                                        <%= missionSelected[i].mission_title %>
                                                    </p>
                                                </td>
                                                <td class="color">
                                                    <%= missionSelected[i].mission_date %>
                                                </td>
                                                <td>
                                                    <%= missionSelected[i].mission_category_name %>
                                                </td>
                                                <td class="color">
                                                    <%= missionSelected[i].city_name %>
                                                </td>
                                                <td><a href="/dataMission/<%= missionSelected[i].id_mission %>">Voir
                                                        d’avantage</a></td>
                                                <td>
                                                    Je participe
                                                    <input
                                                        data-id="<%= JSON.stringify({id: missionSelected[i].id_mission, title: missionSelected[i].mission_title}) %>"
                                                        type="checkbox" name="missionRegistration" class="checkbox"
                                                        value="0">
                                                </td>
                                            </tr>
                                            <% } %>
                                                <% } else { %>
                                                    <% for (let i= 0; i < missions.length; i++) { %>
                                                        <tr>
                                                            <td>
                                                                <p>
                                                                    <%= missions[i].mission_title %>
                                                                </p>
                                                            </td>
                                                            <td class="color">
                                                                <%= missions[i].mission_date %>
                                                            </td>
                                                            <td>
                                                                <%= missions[i].mission_category_name %>
                                                            </td>
                                                            <td class="color">
                                                                <%= missions[i].city_name %>
                                                            </td>
                                                            <td><a href="/dataMission/<%= missions[i].id_mission %>">Voir
                                                                    d’avantage</a></td>
                                                            <td>
                                                                Je participe
                                                                <input
                                                                    data-id="<%= JSON.stringify({id: missions[i].id_mission, title: missions[i].mission_title}) %>"
                                                                    type="checkbox" name="missionRegistration"
                                                                    class="checkbox" value="0">
                                                            </td>
                                                        </tr>
                                                    <% } %>
                                                <% } %>
                                </tbody>
                            </table>
                        </section>

                        <!-- RESPONSIV MOBILE CARD -->

                        <div class="responsiv cardFlexMission">
                            <% if (missionSelected) { %>
                                <% for (let i=0; i < missionSelected.length; i++) { %>
                                    <div class="pictureMissionAndTxt">
                                        <img src="/pictures/Bénévolat.jpg" alt="">
                                        <div>
                                            <h3>
                                                <%= missionSelected[i].mission_title %> - <%=
                                                        missionSelected[i].mission_date %>
                                            </h3>
                                            <div class="line lineMissions"></div>
                                            <p>
                                                <%= missionSelected[i].mission_description %>
                                            </p>
                                            <div class="row flex">
                                                <a href=""
                                                    data-id="<%= JSON.stringify({id: missionSelected[i].id_mission, title: missionSelected[i].mission_title}) %>"
                                                    class="btnSecondary btnHover widthBtnMission btnRegistration">Rejoindre</a>
                                                <a href="" class="btnPrimary btnHover">Détail</a>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                                        <% } else {%>
                                            <% for (let i=0; i < missions.length; i++) { %>
                                                <div class="pictureMissionAndTxt">
                                                    <img src="/pictures/Bénévolat.jpg" alt="">
                                                    <div>
                                                        <h3>
                                                            <%= missions[i].mission_title %> - <%=
                                                                    missions[i].mission_date %>
                                                        </h3>
                                                        <div class="line lineMissions"></div>
                                                        <p>
                                                            <%= missions[i].mission_description %>
                                                        </p>
                                                        <div class="row flex">
                                                            <a href=""
                                                                data-id="<%= JSON.stringify({id: missions[i].id_mission, title: missions[i].mission_title}) %>"
                                                                class="btnSecondary btnHover widthBtnMission btnRegistration">Rejoindre</a>
                                                            <a href="" class="btnPrimary btnHover">Détail</a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% } %>
                                                    <% } %>
                        </div>
            </div>
        </main>

        <%- include('../partials/_mobileFooter') %>