<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/styleListMission.css">
<link rel="stylesheet" href="/style/modal/subscribe.css">
<script src="/javaScript/registerMission.js" defer></script>

<%- include('../partials/_head') %>
<%- include('../partials/_alert') %>

<main>
    <div class="modalContain"></div>

    <div class="container">
        <%- include('../partials/_sideNavUser') %>
        <%- include('../partials/_mobileHeader') %>

        <section class="blocListMission">
            <div class="titleAndCategorySearch">
                <div class="rowResponsiv">
                    <div class="line responsiv"></div>
                    <h1>Mission disponible</h1>
                    <div class="line"></div>
                </div>

                <form action="/searchByCategories" method="post">
                    <div class="rowResponsiv rowDesktop">
                        <div>
                            <p class="responsivMob">Lieu</p>
                            <select name="regionSelected" id="regionSelected">
                                <option value="">Régions</option>
                                <% for (let region of data.regions) { %>
                                    <option
                                        value="<%= region.id_region %>"
                                        <%= region.id_region == regionSelected ? "selected" : "" %>>
                                        <%= region.region_name %>
                                    </option>
                                <% } %>
                            </select>

                            <p class="responsivMob">Categorie</p>
                            <select name="categorySelected" id="categorySelected">
                                <option value="">Catégories</option>
                                <% for (let category of data.categoriesMission) { %>
                                    <option
                                        value="<%= category.id_mission_category %>"
                                        <%= category.id_mission_category == categorySelected ? "selected" : "" %>>
                                        <%= category.mission_category_name %>
                                    </option>
                                <% } %>
                            </select>
                        </div>

                        <div class="filterDate">
                            <div>
                                <p>Du :</p>
                                <input type="date" id="tripStart" name="tripStart">
                            </div>
                            <div>
                                <p>Au :</p>
                                <input type="date" id="tripEnd" name="tripEnd">
                            </div>
                        </div>

                        <button class="btnSecondary btnHover" type="submit">Rechercher</button>
                        <a href="/missionUserShow">
                            <img class="btnReset" src="/pictures/recycler.png" alt="">
                        </a>
                    </div>
                </form>
            </div>

            <!-- TABLE DESKTOP -->
            <table class="desktop">
                <thead>
                    <tr>
                        <th>MISSION</th>
                        <th>DATE</th>
                        <th>CATEGORIES</th>
                        <th>LIEUX</th>
                        <th>DETAILS</th>
                        <th>S'INSCRIRE</th>
                    </tr>
                </thead>
                <tbody class="fixMax">
                    <% const missionList = data.missionSelected || data.missionsClear; %>
                    <% for (let i = 0; i < missionList.length; i++) { %>
                        <tr>
                            <td><p><%= missionList[i].title %></p></td>
                            <td class="color"><%= missionList[i].date %></td>
                            <td><%= missionList[i].category %></td>
                            <td class="color"><%= missionList[i].city %></td>
                            <td>
                                <a href="/dataMission/<%= missionList[i].id %>">
                                    Voir d’avantage
                                </a>
                            </td>
                            <td>
                                Je participe
                                <input
                                    type="checkbox"
                                    class="checkbox"
                                    name="missionRegistration"
                                    value="0"
                                    data-id="<%= JSON.stringify({ id: missionList[i].id, title: missionList[i].title }) %>">
                            </td>
                        </tr>
                    <% } %>                    
                </tbody>
            </table>
        </section>

        <!-- RESPONSIVE MOBILE CARD -->
        <div class="responsiv cardFlexMission">
            <% if (data.missionSelected) { %>
                <% for (let i = 0; i < data.missionSelected.length; i++) { %>
                    <div class="pictureMissionAndTxt">
                        <img src="<%= data.missionSelected[i].img %>" alt="">
                        <div>
                            <h3>
                                <%= data.missionSelected[i].title %> -
                                <%= data.missionSelected[i].date %>
                            </h3>
                            <div class="line lineMissions"></div>
                            <p><%= data.missionSelected[i].description + " ..." %></p>
                            <div class="row flex">
                                <a
                                    href=""
                                    class="btnSecondary btnHover widthBtnMission btnRegistration"
                                    data-id="<%= JSON.stringify({ id: data.missionSelected[i].id, title: data.missionSelected[i].title }) %>">
                                    Rejoindre
                                </a>
                                <a href="" class="btnPrimary btnHover">Détail</a>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% } else { %>
                <% for (let i = 0; i < data.missionsClear.length; i++) { %>
                    <div class="pictureMissionAndTxt">
                        <img src="<%= data.missionsClear[i].img %>" alt="">
                        <div>
                            <h3>
                                <%= data.missionsClear[i].id %> -
                                <%= data.missionsClear[i].date %>
                            </h3>
                            <div class="line lineMissions"></div>
                            <p><%= data.missionsClear[i].description + " ..."%></p>
                            <div class="row flex">
                                <a
                                    href=""
                                    class="btnSecondary btnHover widthBtnMission btnRegistration"
                                    data-id="<%= JSON.stringify({ id: data.missionsClear[i].id, title: data.missionsClear[i].title }) %>">
                                    Rejoindre
                                </a>
                                <a href="" class="btnPrimary btnHover">Détail</a>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% } %>
        </div>
    </div>
</main>

<%- include('../partials/_mobileFooter') %>
