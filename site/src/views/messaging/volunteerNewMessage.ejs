<link rel="stylesheet" href="/style/globalStyle.css">
<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/newMessage.css">
<link rel="stylesheet" href="/style/account/newMessageVolunteer.css">
<link rel="stylesheet" href="/style/account/messagingMobile.css">

<%- include('../partials/_head') %>
<%- include('../partials/_alert') %>

<main>
    <div class="container">
        <%- include('../partials/_sideNavUser') %>                
        <%- include('../partials/_mobileHeader') %>

        <section class="newMessage backgroundCards backgroundResponsiv">
            <div class="row rowResponsiv">
                <div class="h1Line h1LineResponsiv">
                    <h1>Nouveau message</h1>
                    <div class="line lineResponsiv"></div>
                </div>                
                <a href="/messaging">
                    <img class="btnReset" src="/pictures/iconHeader-Footer/crossList.png" alt="">
                </a>
            </div>
            <fieldset>
                <legend>Objet et contenu</legend>
                <form action="/admin/message"  method="POST">
                    <label for="object">
                        <input type="text" name="object" placeholder="Demande d'informations, Question technique..." id="object" value="<%= object ? object : "" %>">
                    </label>
                    <label for="textarea" class="textareaLabel"></label>
                    <textarea placeholder="Écrivez votre message ici..." name="content" id="textarea"><%= textarea ? textarea : "" %></textarea>
                    <button class="btnHover btnSecondary" type="submit">ENVOYER</button>
                </form>
            </fieldset>
            
        </section>        
        
    </div>
    <%- include('../partials/_mobileFooter') %>
</main>


</body>

</html>