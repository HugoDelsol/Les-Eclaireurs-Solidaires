<link rel="stylesheet" href="/style/globalStyle.css">
<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/messaging.css">
<link rel="stylesheet" href="/style/account/messagingMobile.css">

<%- include('../partials/_head') %>
<%- include('../partials/_alert') %>

<main>
    <div class="container">
        <%- include('../partials/_sideNavUser') %>
        <%- include('../partials/_mobileHeader') %>
        <section class="listOfMessage backgroundCards">
            <div class="rowLine">
                <div class="h1Line">
                    <h1>Messages</h1>
                    <div class="line"></div>
                </div>                    
                <a class="btnHover btnSecondary" href="/newMessageByVolunteer"> Nouveau message<img src="/pictures/globalIcons/message-ouvert.png" alt=""></a>
            </div>
            <div class="colMessage">
                <% for (const d of data) { %>
                    <a href="/chatMessage/<%= d.id_chat_channel %>"class="rowMessage">
                        <% if (d.chat_message_from_user === 0) { %>
                            <img class="red" src="/pictures/globalIcons/cercle.png" alt="">
                        <% } else if (d.chat_message_status === 2) { %>
                            <img class="grey" src="/pictures/globalIcons/grey.png" alt="">
                        <% } else if (d.chat_message_status === 3) { %>
                            <img class="red" src="/pictures/globalIcons/bouton.png" alt="">
                        <% } %>
                        <img src="/pictures/globalIcons/bavarder.png" alt="">
                        <p>Objet : <span><%= d.chat_channel_object  %></span></p>
                        <p class="paragraph">Canal créer le : <span><%= d.chat_channel_date %></span></p>
                        <img src="/pictures/globalIcons/envoyer.png" alt="">
                    </a>   
                <% } %> 
            </div>               
        </section>
    </div>
</main>

<%- include('../partials/_mobileFooter') %>

</body>

</html>