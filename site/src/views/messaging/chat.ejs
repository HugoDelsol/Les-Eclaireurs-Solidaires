<link rel="stylesheet" href="/style/globalStyle.css">
<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/chat.css">
<script src="/javaScript/style.js" defer></script>
<script src="/javaScript/minWidthRequired.js" defer></script>

<%- include('../partials/_head') %>
<%- include('../partials/_alert') %>

<div class="containerDisplay">
    <%- include('../partials/_sideNavAdmin') %>
    <main class="mainBackOffice">
        <div class="colContainer">
            <section class="chat backgroundCards">
                <div class="rowLine"> 
                    <div class="line"></div>                                   
                    <p><span>OBJET :</span> <%= dataId[0].chat_channel_object  %></p>
                    <p>|</p>
                    <p><span>EMAIL :</span>  <a href=""><%= dataId[0].identifier_mail   %></a></p> 
                     <a class="cross" href="/admin/messaging">
                        <img class="btnReset" src="/pictures/iconHeader-Footer/crossList.png" alt="">
                    </a>                                    
                </div>                 
                <div class="displayChat"> 
                    <% for (const dm of dataMessages) { %>
                        <div class="<%= dm.chat_message_from_user === 1 ? "messageSent" :  "messageReceived" %>">
                            <pre><%= dm.chat_message_content %></pre>                                                          
                            <div class="<%= dm.chat_message_from_user === 1 ? "dateMessageSent" :  "dateMessageReceived" %>"><%= dm.date %></div> 
                        </div>  
                    <% } %>                                        
                </div>              
            </section>
            <section class="txtArea backgroundCards">
                <form action="/replyToAMessage" method="post">
                    <label for="textarea"></label>
                    <textarea name="textarea" id="textarea"><%= textarea ? textarea : "" %></textarea>
                    <label for="idChannel"></label>
                    <button class="btnHover btnSecondary">ENVOYER</button>
                </form>
            </section>
        </div>
            
    </main>
</div>

</body>

</html>

<script>
    const scrollDiv = document.querySelector(".displayChat");
    scrollDiv.scrollTop = scrollDiv.scrollHeight;
</script>