<link rel="stylesheet" href="/style/globalStyle.css">
<link rel="stylesheet" href="/style/account/styleSideNav.css">
<link rel="stylesheet" href="/style/account/chat.css">
<link rel="stylesheet" href="/style/account/messagingMobile.css">
<script src="/javaScript/style.js" defer></script>

<%- include('../partials/_head') %>
<%- include('../partials/_alert') %>
<%- include('../partials/_mobileHeader') %>

<div class="containerDisplay">
    <%- include('../partials/_sideNavUser') %>
<main class="mainBackOffice">
        <div class="colContainer">
            <section class="chat backgroundCards backgroundCardsChat">
                <div class="rowLineChat"> 
                    <div class="rowChat">
                        <p><span>OBJET :</span> <%= dataId[0].chat_channel_object  %></p>
                        <div class="line"></div>   
                    </div>                                                       
                     <a class="cross" href="/messaging">
                        <img class="btnReset" src="/pictures/iconHeader-Footer/crossList.png" alt="Fermer la page">
                    </a>                                    
                </div>                 
                <div class="displayChat"> 
                    <% for (const dm of dataMessages) { %>
                        <div class="<%= dm.chat_message_from_user === 0 ? "messageSent" :  "messageReceived" %>">
                            <pre><%= dm.chat_message_content %></pre>                                                          
                            <div class="<%= dm.chat_message_from_user === 0 ? "dateMessageSent" :  "dateMessageReceived" %>"><%= dm.date %></div> 
                        </div>  
                    <% } %>                                 
                </div>              
            </section>
            <section class="txtArea backgroundCards backgroundCardsChat">
                <form action="/replyToAMessage" method="post" class="formChat">
                    <label for="textarea"></label>
                    <textarea name="textarea" id="textarea"><%= textarea ? textarea : "" %></textarea>
                    <label for="idChannel"></label>
                    <button class="btnHover btnSecondary">
                        <img style="width: 28px;" src="/pictures/globalIcons/envoyer.png" alt="Envoyer">
                    </button>
                </form>
            </section>
        </div>
            
 
    
</main>
</div>

    
<%- include('../partials/_mobileFooter') %>

</body>

</html>

<script>
    const scrollDiv = document.querySelector(".displayChat");
    scrollDiv.scrollTop = scrollDiv.scrollHeight;
</script>