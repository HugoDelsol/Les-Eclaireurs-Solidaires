<%- include('../partials/_head') %>

<div class="modalBackground">
    <div class="modal">
        <div class="sizedBox">
            <h2>Se désinscrire de la mission : <span></span> ?</h2>
        </div>

        <div class="sizedBox">
            <p>
                Vous êtes sur le point d’annuler votre participation à cette mission.
                Si vous confirmez, votre place sera libérée et vous ne serez plus
                attendu(e) à la date prévue.
            </p>
        </div>

        <div class="btnCol">
            <a href="#" class="btnUnsubscribeConfirmation btnPrimary btnHover">Oui, me désinscrire</a>
            <button class="close btnSecondary btnHover">Annuler</button>
        </div>
    </div>

    <div class="modalToggle">
        <div class="sizedBox">
            <h2>Votre désinscription a bien été prise en compte.</h2>
        </div>
    </div>
</div>
